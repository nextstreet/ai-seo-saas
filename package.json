{
  "name": "ai-seo-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ai-seo/web dev",
    "cms:up": "docker compose --env-file directus/.env -f directus/docker-compose.yml up -d",
    "cms:down": "docker compose --env-file directus/.env -f directus/docker-compose.yml down",
    "cms:bootstrap": "node directus/bootstrap.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
