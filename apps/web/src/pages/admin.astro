---
import BaseLayout from '@/components/BaseLayout.astro';
import { getSystemSnapshot } from '@/lib/data';

const snapshot = getSystemSnapshot();
---

<BaseLayout title="CMS Console | Ita SEO OS" description="Manage candidate content, quality gates, topic graph, and publish readiness for the Custom Ita Bag SEO system.">
  <section class="shell hero" style="grid-template-columns: 1fr;">
    <div>
      <h1>CMS Console</h1>
      <p class="lede">Candidate-first content management for the Custom Ita Bag validation site. The V1 rule is simple: candidates can scale; publishing still requires intent difference, assets, and buyer value.</p>
      <p><a class="button" href="/admin/site">Manage storefront settings</a></p>
    </div>
  </section>

  <section class="shell split band">
    <aside class="sidebar">
      <div class="card">
        <h3>Tenant</h3>
        <p>{snapshot.tenant.name}</p>
        <div class="pillrow">
          <span class="pill">{snapshot.topics.length} topics</span>
          <span class="pill">{snapshot.entities.length} entities</span>
          <span class="pill">{snapshot.products.length} products</span>
          <span class="pill">{snapshot.designs.length} designs</span>
          <span class="pill">{snapshot.materials.length} materials</span>
          <span class="pill">{snapshot.intents.length} intents</span>
        </div>
      </div>
    </aside>

    <div>
      <div class="console-head">
        <div><h2>Candidate Content</h2><p class="meta">Live tenant queue ordered by opportunity and quality.</p></div>
        <button id="refresh-candidates" class="button" type="button">Refresh</button>
      </div>
      <p id="candidate-status" class="meta" role="status">Loading candidate queue...</p>
      <table>
        <thead>
          <tr>
            <th>Candidate</th>
            <th>Type</th>
            <th>Scores</th>
            <th>Gate</th>
          </tr>
        </thead>
        <tbody id="candidate-rows"></tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<script>
  const refresh = document.querySelector<HTMLButtonElement>('#refresh-candidates');
  const rows = document.querySelector<HTMLTableSectionElement>('#candidate-rows');
  const status = document.querySelector<HTMLElement>('#candidate-status');

  const element = (tag: string, text: string, className = '') => {
    const node = document.createElement(tag);
    node.textContent = text;
    if (className) node.className = className;
    return node;
  };

  async function loadCandidates() {
    if (!rows || !status) return;
    status.textContent = 'Loading candidate queue...';
    rows.replaceChildren();

    try {
      const response = await fetch('/api/admin/candidates');
      const result = await response.json();
      if (!response.ok) {
        status.textContent = result.error || 'Unable to load candidates.';
        return;
      }

      const candidates = [...result.candidates].sort((left, right) =>
        right.opportunityScore + right.qualityScore - (left.opportunityScore + left.qualityScore)
      );
      for (const candidate of candidates) {
        const row = document.createElement('tr');
        const identity = document.createElement('td');
        identity.append(element('strong', candidate.title), element('div', candidate.primaryKeyword, 'meta'), element('div', `/${candidate.slug}`, 'meta'));
        const type = element('td', String(candidate.pageType).replaceAll('_', ' '));
        const scores = document.createElement('td');
        const opportunity = document.createElement('div');
        opportunity.append(element('span', String(candidate.opportunityScore), 'score'), ' opportunity');
        const quality = document.createElement('div');
        quality.append(element('span', String(candidate.qualityScore), 'score'), ' quality');
        scores.append(opportunity, quality);
        const gate = document.createElement('td');
        gate.append(element('span', candidate.status, 'pill'), element('p', candidate.qualityGate?.notes?.[0] || 'Awaiting review.', 'meta'));
        row.append(identity, type, scores, gate);
        rows.append(row);
      }
      status.textContent = `${candidates.length} candidates loaded.`;
    } catch {
      status.textContent = 'The server could not be reached.';
    }
  }
  refresh?.addEventListener('click', loadCandidates);
  loadCandidates();
</script>

<style>
  .console-head { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 14px; }
  .console-head h2 { margin-bottom: 4px; }
  #candidate-status { margin-bottom: 14px; }
  @media(max-width: 760px) { .console-head { display: grid; } }
</style>
