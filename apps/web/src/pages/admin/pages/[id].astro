---
import BaseLayout from '@/components/BaseLayout.astro';
import { adminText, getAdminLocale } from '@/lib/admin-locale';
const locale = getAdminLocale(Astro.cookies.get('admin_locale')?.value);
const tr = (zh: string, en: string) => adminText(locale, zh, en);
---
<BaseLayout title={`${tr('页面编辑', 'Page editor')} | Ita SEO OS`} description={tr('编辑并推进页面发布状态。', 'Edit and advance a page through publication.')}>
  <section class="shell hero editor-head"><div><p class="kicker">Editorial workflow</p><h1>{tr('页面编辑', 'Page editor')}</h1><p id="page-meta" class="lede">{tr('正在加载页面...', 'Loading page...')}</p></div><a class="button" href="/admin/pages">{tr('返回页面列表', 'Back to pages')}</a></section>
  <form class="shell editor" id="page-form">
    <section class="card form-grid"><label class="wide">{tr('页面标题', 'Title')}<input name="title" maxlength="160" required /></label><label>Slug<input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" /></label><label>{tr('核心关键词', 'Primary keyword')}<input name="primaryKeyword" required /></label><label class="wide">Meta Description<textarea name="metaDescription" rows="2" maxlength="320" required></textarea></label><label class="wide">{tr('首屏摘要', 'Hero summary')}<textarea name="heroSummary" rows="3" maxlength="600" required></textarea></label></section>
    <section class="card"><div class="section-head"><div><h2>{tr('正文分区', 'Body sections')}</h2><p class="meta">{tr('发布前，每个分区必须有标题和至少一段 40 字符以上的正文。', 'Before publication, every section needs a heading and at least one paragraph of 40 characters.')}</p></div><button class="button" id="add-section" type="button">+ {tr('添加分区', 'Add section')}</button></div><div id="sections"></div></section>
    <section class="card"><div class="section-head"><h2>{tr('内部链接', 'Internal links')}</h2><button class="button" id="add-link" type="button">+ {tr('添加链接', 'Add link')}</button></div><div id="links"></div></section>
    <section class="save-row"><button class="button primary" type="submit">{tr('保存内容', 'Save content')}</button><span id="save-status" role="status"></span></section>
  </form>
  <section class="shell card workflow"><div><h2>{tr('发布状态', 'Publishing status')}</h2><p id="workflow-status" class="meta"></p></div><div class="transition-controls"><select id="next-status"></select><input id="reason" placeholder={tr('填写状态变更原因', 'Reason for status change')} /><button class="button primary" id="transition" type="button">{tr('推进状态', 'Move status')}</button></div><a id="public-link" class="button" target="_blank" hidden>{tr('查看公开页面', 'View public page')}</a></section>
</BaseLayout>
<script>
  const pageId = window.location.pathname.split('/').filter(Boolean).at(-1) || '';
  const isZh=document.documentElement.lang==='zh-CN';
  const labels:Record<string,string>=isZh?{draft:'草稿',review:'审核中',published:'已发布',refresh:'待更新',archived:'已归档'}:{draft:'Draft',review:'Review',published:'Published',refresh:'Refresh',archived:'Archived'};
  const transitions:Record<string,string[]>={draft:['review','archived'],review:['draft','published','archived'],published:['refresh','archived'],refresh:['draft','archived'],archived:[]};
  const form=document.querySelector<HTMLFormElement>('#page-form'); const sections=document.querySelector<HTMLElement>('#sections'); const links=document.querySelector<HTMLElement>('#links'); const saveStatus=document.querySelector<HTMLElement>('#save-status'); const workflowStatus=document.querySelector<HTMLElement>('#workflow-status'); const nextStatus=document.querySelector<HTMLSelectElement>('#next-status'); let page:any;
  const input=(name:string,value='',type='input')=>{const el=document.createElement(type) as HTMLInputElement|HTMLTextAreaElement; el.name=name; el.value=value; return el;};
  function sectionRow(value:any={heading:'',paragraphs:[]}){const field=document.createElement('fieldset');const heading=input('heading',value.heading);heading.placeholder=isZh?'分区标题':'Section heading';const paragraphs=input('paragraphs',(value.paragraphs||[]).join('\n\n'),'textarea');paragraphs.placeholder=isZh?'段落之间空一行':'Separate paragraphs with a blank line';(paragraphs as HTMLTextAreaElement).rows=7;const bullets=input('bullets',(value.bullets||[]).join('\n'),'textarea');bullets.placeholder=isZh?'要点，每行一条（可选）':'Bullets, one per line (optional)';(bullets as HTMLTextAreaElement).rows=3;const remove=document.createElement('button');remove.type='button';remove.className='button remove';remove.textContent=isZh?'删除分区':'Remove section';remove.onclick=()=>field.remove();field.append(heading,paragraphs,bullets,remove);sections?.append(field);}
  function linkRow(value:any={label:'',slug:''}){const row=document.createElement('div');row.className='link-row';const label=input('label',value.label);label.placeholder=isZh?'链接文字':'Link label';const slug=input('linkSlug',value.slug);slug.placeholder='slug';const remove=document.createElement('button');remove.type='button';remove.className='button';remove.textContent='×';remove.title=isZh?'删除链接':'Remove link';remove.onclick=()=>row.remove();row.append(label,slug,remove);links?.append(row);}
  function setField(name:string,value:string){const field=form?.elements.namedItem(name) as HTMLInputElement|HTMLTextAreaElement|null;if(field)field.value=value;}
  function renderWorkflow(){if(!page||!nextStatus||!workflowStatus)return;workflowStatus.textContent=(isZh?'当前状态：':'Current status: ')+(labels[page.status]||page.status);nextStatus.replaceChildren();for(const status of transitions[page.status]||[])nextStatus.add(new Option(labels[status]||status,status));const publicLink=document.querySelector<HTMLAnchorElement>('#public-link');if(publicLink){publicLink.href=`/content/${page.slug}`;publicLink.hidden=page.status!=='published';}}
  async function load(){try{const response=await fetch(`/api/admin/pages/${pageId}`);const result=await response.json();if(!response.ok)throw new Error(result.error);page=result.page;setField('title',page.title);setField('slug',page.slug);setField('primaryKeyword',page.primaryKeyword);setField('metaDescription',page.metaDescription);setField('heroSummary',page.heroSummary);sections?.replaceChildren();links?.replaceChildren();page.body.forEach(sectionRow);page.internalLinks.forEach(linkRow);if(!page.body.length)sectionRow();document.querySelector('#page-meta')!.textContent=`${page.pageType.replaceAll('_',' ')} · v${page.contentVersion}`;renderWorkflow();}catch(error){document.querySelector('#page-meta')!.textContent=(error as Error).message;}}
  form?.addEventListener('submit',async event=>{event.preventDefault();if(saveStatus)saveStatus.textContent=isZh?'正在保存...':'Saving...';const data=new FormData(form);const body=[...(sections?.querySelectorAll('fieldset')||[])].map(field=>({heading:(field.querySelector('[name=heading]') as HTMLInputElement).value,paragraphs:(field.querySelector('[name=paragraphs]') as HTMLTextAreaElement).value.split(/\n\s*\n/).map(x=>x.trim()).filter(Boolean),bullets:(field.querySelector('[name=bullets]') as HTMLTextAreaElement).value.split('\n').map(x=>x.trim()).filter(Boolean)}));const internalLinks=[...(links?.querySelectorAll('.link-row')||[])].map(row=>({label:(row.querySelector('[name=label]') as HTMLInputElement).value,slug:(row.querySelector('[name=linkSlug]') as HTMLInputElement).value})).filter(link=>link.label||link.slug);const payload={title:data.get('title'),slug:data.get('slug'),primaryKeyword:data.get('primaryKeyword'),metaDescription:data.get('metaDescription'),heroSummary:data.get('heroSummary'),body,internalLinks};try{const response=await fetch(`/api/admin/pages/${pageId}`,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const result=await response.json();if(!response.ok)throw new Error(result.error);page=result.page;if(saveStatus)saveStatus.textContent=isZh?'已保存。':'Saved.';renderWorkflow();}catch(error){if(saveStatus)saveStatus.textContent=(error as Error).message;}});
  document.querySelector('#add-section')?.addEventListener('click',()=>sectionRow());document.querySelector('#add-link')?.addEventListener('click',()=>linkRow());document.querySelector('#transition')?.addEventListener('click',async()=>{const reason=(document.querySelector<HTMLInputElement>('#reason')?.value||'').trim();if(!nextStatus?.value||!reason){if(workflowStatus)workflowStatus.textContent=isZh?'请选择状态并填写原因。':'Choose a status and enter a reason.';return;}try{const response=await fetch(`/api/admin/pages/${pageId}/transition`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({status:nextStatus.value,reason})});const result=await response.json();if(!response.ok)throw new Error(result.error);await load();}catch(error){if(workflowStatus)workflowStatus.textContent=(error as Error).message;}});load();
</script>
<style>
  .editor-head{grid-template-columns:1fr auto;align-items:end}.editor{display:grid;gap:18px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.wide{grid-column:1/-1}label{display:grid;gap:6px;font-size:12px;font-weight:700;color:var(--muted)}input,textarea,select{width:100%;border:1px solid var(--line);padding:10px;font:inherit;background:#fff}.section-head,.save-row,.workflow,.transition-controls{display:flex;align-items:center;justify-content:space-between;gap:12px}.section-head{margin-bottom:14px}fieldset{display:grid;gap:9px;border:1px solid var(--line);padding:14px;margin:0 0 12px}.remove{justify-self:end}.link-row{display:grid;grid-template-columns:1fr 1fr auto;gap:9px;margin-bottom:9px}.save-row{justify-content:flex-start;padding-bottom:18px}.workflow{margin-top:18px;margin-bottom:70px}.transition-controls{flex:1}.transition-controls input{min-width:240px}#public-link[hidden]{display:none}@media(max-width:760px){.editor-head,.form-grid{grid-template-columns:1fr}.wide{grid-column:auto}.section-head,.workflow,.transition-controls{align-items:stretch;flex-direction:column}.link-row{grid-template-columns:1fr}.transition-controls input{min-width:0}}
</style>
