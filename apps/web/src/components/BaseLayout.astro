---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'http://localhost:4321';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <style is:global>
      :root {
        color-scheme: light;
        --ink: #171717;
        --muted: #5f6368;
        --line: #d9d5cc;
        --paper: #fbfaf7;
        --panel: #ffffff;
        --accent: #0f766e;
        --accent-dark: #115e59;
        --rose: #be3455;
        --gold: #ad7a24;
        --sky: #2f6f9f;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        line-height: 1.55;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        display: block;
        max-width: 100%;
      }

      .shell {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      .topbar {
        border-bottom: 1px solid var(--line);
        background: rgba(251, 250, 247, 0.94);
        position: sticky;
        top: 0;
        z-index: 5;
        backdrop-filter: blur(12px);
      }

      .nav {
        height: 62px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        font-weight: 800;
        letter-spacing: 0;
      }

      .navlinks {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .navlinks a,
      .button {
        border: 1px solid transparent;
        padding: 8px 11px;
        border-radius: 7px;
        font-size: 14px;
        color: var(--muted);
      }

      .navlinks a:hover,
      .button:hover {
        border-color: var(--line);
        color: var(--ink);
        background: var(--panel);
      }

      .button.primary {
        background: var(--accent);
        color: #fff;
        border-color: var(--accent);
      }

      .button.primary:hover {
        background: var(--accent-dark);
      }

      main {
        min-height: calc(100vh - 134px);
      }

      .hero {
        padding: 52px 0 34px;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
        gap: 36px;
        align-items: center;
      }

      .hero h1,
      h1 {
        font-size: clamp(38px, 6vw, 68px);
        line-height: 0.98;
        letter-spacing: 0;
        margin: 0 0 18px;
      }

      h2 {
        font-size: 28px;
        line-height: 1.12;
        margin: 0 0 14px;
      }

      h3 {
        font-size: 18px;
        margin: 0 0 8px;
      }

      p {
        margin: 0 0 14px;
      }

      .lede {
        font-size: 18px;
        color: var(--muted);
        max-width: 720px;
      }

      .hero-visual {
        min-height: 370px;
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
        background:
          linear-gradient(135deg, rgba(15, 118, 110, 0.22), transparent 36%),
          linear-gradient(315deg, rgba(190, 52, 85, 0.22), transparent 32%),
          #efeae0;
        position: relative;
      }

      .bag-preview {
        position: absolute;
        inset: 44px 58px 34px;
        border: 3px solid #222;
        border-radius: 34px 34px 20px 20px;
        background: #f7d7df;
        box-shadow: 0 24px 70px rgba(23, 23, 23, 0.2);
      }

      .bag-preview::before {
        content: "";
        position: absolute;
        width: 42%;
        height: 34%;
        left: 29%;
        top: -38px;
        border: 8px solid #222;
        border-bottom: 0;
        border-radius: 80px 80px 0 0;
      }

      .window {
        position: absolute;
        left: 16%;
        right: 16%;
        top: 22%;
        bottom: 18%;
        border: 3px solid rgba(34, 34, 34, 0.82);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.62);
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        padding: 18px;
      }

      .pin {
        border-radius: 999px;
        background: var(--accent);
        border: 2px solid #222;
        aspect-ratio: 1;
      }

      .pin:nth-child(2n) {
        background: var(--gold);
      }

      .pin:nth-child(3n) {
        background: var(--sky);
      }

      .band {
        padding: 34px 0;
        border-top: 1px solid var(--line);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 18px;
      }

      .card p,
      .meta {
        color: var(--muted);
        font-size: 14px;
      }

      .pillrow {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .pill {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 4px 9px;
        font-size: 12px;
        color: var(--muted);
        background: #fff;
      }

      .score {
        font-weight: 800;
        color: var(--accent-dark);
      }

      .split {
        display: grid;
        grid-template-columns: 260px minmax(0, 1fr);
        gap: 22px;
        align-items: start;
      }

      .sidebar {
        position: sticky;
        top: 82px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
      }

      th,
      td {
        text-align: left;
        padding: 12px;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
        font-size: 14px;
      }

      th {
        color: var(--muted);
        font-weight: 700;
        background: #f4f1ea;
      }

      footer {
        border-top: 1px solid var(--line);
        padding: 22px 0;
        color: var(--muted);
        font-size: 14px;
      }

      @media (max-width: 820px) {
        .hero,
        .grid,
        .split {
          grid-template-columns: 1fr;
        }

        .hero {
          padding-top: 34px;
        }

        .hero-visual {
          min-height: 310px;
        }

        .bag-preview {
          inset: 44px 34px 28px;
        }

        .sidebar {
          position: static;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <nav class="shell nav" aria-label="Primary">
        <a class="brand" href="/">Ita SEO OS</a>
        <div class="navlinks">
          <a href="/admin">CMS</a>
          <a href="/gallery">Gallery</a>
          <a href="/api/admin/candidates">API</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="shell">Multi-tenant SEO core for intent-led pages, community feedback, and future SaaS expansion.</div>
    </footer>
  </body>
</html>
